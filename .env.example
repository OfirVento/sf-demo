# Vento CPQ→RCA Assessment — local environment
#
# Copy this file to `.env` and fill in your values. `.env` is gitignored.
#
# VITE_AGENT_MODEL: the Anthropic model ID. Use the exact catalog string.
#   Default below is the literal value approved for the demo. If the API
#   rejects it, swap in claude-sonnet-4-6 (canonical) without code changes.
VITE_AGENT_MODEL=claude-sonnet-4

# VITE_ANTHROPIC_API_KEY: your Anthropic API key.
# Required from M3 onward (live agent panel + narrative re-roll).
# WARNING: VITE_ prefixed vars are exposed in the browser bundle. This is
# acceptable for the AllCloud demo on a controlled URL; do not deploy this
# pattern to a public production environment.
VITE_ANTHROPIC_API_KEY=sk-ant-...
